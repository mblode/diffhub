{
  "name": "diffhub",
  "version": "1.0.0",
  "description": "Git diff viewer for cmux: review your branch in a browser split",
  "keywords": [
    "ai",
    "cli",
    "cmux",
    "code-review",
    "diff",
    "diff-viewer",
    "git",
    "git-diff",
    "github",
    "pr"
  ],
  "homepage": "https://blode.co/diffhub",
  "license": "MIT",
  "author": "Matthew Blode <m@blode.co> (https://blode.co)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mblode/diffhub"
  },
  "bin": {
    "diffhub": "./bin/diffhub.mjs"
  },
  "files": [
    "bin/",
    ".next/standalone/",
    "package.json"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless run --force next dev",
    "build": "next build",
    "prepare:standalone": "node ./bin/prepare-standalone.mjs",
    "prepack": "next build && npm run prepare:standalone",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check-types": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "next build && npm run prepare:standalone && changeset publish"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@changesets/cli": "^3.0.3",
    "@diffhub/diff-core": "*",
    "@pierre/diffs": "^1.4.3",
    "@pierre/trees": "^1.0.0-beta.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.1.2",
    "blode-icons-react": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "portless": "^0.15.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "bun": ">=1.0.23",
    "node": ">=20.11"
  }
}
